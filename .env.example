# Set these in the process environment. The engine does not automatically load dotenv files.
XAI_API_KEY=
XAI_MODEL=
# Leave blank for the CLI's configured model; the API backend requires a supported model ID.
# Used by backend=xai; backend=grok-cli uses the installed client's existing login.
# The shared ledger caps research at 24 calls per UTC day.
# The radar allocates 12 background and 12 triggered calls in radar-config.json.

# Optional X stream. Both values are required; Grok login is not X API access.
RADAR_ENABLE_X=0
X_BEARER_TOKEN=

# Optional confirmed transaction-log stream; add addresses to solana_mentions too.
# Keep provider URLs containing credentials in this environment, never in tracked JSON.
RADAR_ENABLE_SOLANA=0
SOLANA_RPC_WS_URL=
